# Application
APP_NAME=Remotion Docker Template
PORT=3000
NODE_ENV=development

# Composition selector for render.mjs / docker compose run
# Valid values: HelloWorld | TransitionsDemo | CaptionsDemo
COMPOSITION_ID=HelloWorld

# HelloWorld inputs
TITLE=Hello World
SUBTITLE=Welcome to Remotion
CONTENT_HEADER=Discover More
OUTRO_MESSAGE=Thank You!

# TransitionsDemo inputs
SCENE_ONE_TEXT=Welcome
SCENE_TWO_TEXT=Built with Remotion
SCENE_THREE_TEXT=Render Anywhere

# CaptionsDemo inputs (path under public/)
SRT_PATH=captions/sample.srt

# AWS / Remotion Lambda — only needed for `npm run lambda:deploy`
# REMOTION_AWS_ACCESS_KEY_ID=
# REMOTION_AWS_SECRET_ACCESS_KEY=
# REMOTION_AWS_REGION=us-east-1
